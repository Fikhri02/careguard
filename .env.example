# ---- Model provider (pick ONE) --------------------------------------------
# Option A: OpenAI directly (marquee sponsor — you get $ credits)
OPENAI_API_KEY=sk-...
MODEL=gpt-4o-mini

# Option B: OpenRouter (sponsor) — one key, any model. Uncomment to use:
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MODEL=openai/gpt-4o-mini

# ---- Tools ----------------------------------------------------------------
# Exa (sponsor) — neural web search + /answer. https://dashboard.exa.ai
EXA_API_KEY=

# ---- Slack surface (only needed for `npm run slack`) ----------------------
# Create an app at https://api.slack.com/apps -> Socket Mode ON
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# ---- WhatsApp surface (Scam Guardian `npm run scam` / iPhone `npm run whatsapp`) ----
# Twilio console -> Messaging -> Try it out -> WhatsApp sandbox
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The sandbox WhatsApp sender, needed so Scam Guardian can alert family:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Scam Guardian: URL reputation (optional but great for the demo) -------
# Free key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=

# ---- Server surface -------------------------------------------------------
PORT=8787
